    "test:watch": "vitest"
  },
  "dependencies": {
    "@ricky0123/vad-web": "0.0.18",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "onnxruntime-web": "1.14.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "protobufjs": "7.6.3"
  }
}
